rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /wallets/{walletId} {
      allow read, write: if request.auth != null && request.auth.uid == walletId;
    }

    match /transactions/{transactionId} {
      allow create: if request.auth != null && request.resource.data.walletId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.walletId == request.auth.uid;
    }
  }
}
